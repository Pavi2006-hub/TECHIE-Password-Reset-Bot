# ==============================================================================
# TECHIE Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting in production.
# ==============================================================================

# Server Environment & Port (Assigned dynamically by Render, Railway, Fly.io, Heroku)
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
# Example: https://techie-app.vercel.app,https://yourdomain.com
FRONTEND_ORIGINS=https://techie-frontend.vercel.app,http://localhost:5173

# Database Persistence Path
# On production, point to a mounted persistent volume or persistent disk
# Example: /mnt/data/techie.db or ./data/techie.db
DATABASE_PATH=./data/techie.db

# Cryptographic Signing Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_64_chars

# Administrator Credentials for Audit Dashboard
ADMIN_USERNAME=techie_admin
ADMIN_PASSWORD=replace_with_strong_random_admin_password_16_chars!

# Production SMTP Email Delivery (SendGrid, Mailgun, AWS SES, Postmark, Brevo)
# For local development with Mailpit, keep host=127.0.0.1, port=1025, tls=false, username/password empty.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_production_smtp_api_key_here
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=security@yourdomain.com

# Git ignore rules for TECHIE

# Environment secrets (NEVER commit to GitHub)
.env
.env.local
.env.*.local
*.env

# SQLite local databases
*.db
*.db-journal
*.sqlite
data/
*.sqlite3

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
backend/venv/
venv/
.venv/
.pytest_cache/
.coverage

# Node.js dependencies and build artifacts
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Mailpit & tools binaries
tools/mailpit.exe
tools/mailpit.zip
tools/LICENSE
tools/README.md

# Operating System artifacts
.DS_Store
Thumbs.db
